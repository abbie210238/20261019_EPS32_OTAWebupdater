// ==================================================
// 版本比較
// ==================================================
bool isNewerVersion(
  const String& remoteVersion,
  const char* currentVersion
) {
  int r1, r2, r3;
  int c1, c2, c3;

  if (sscanf(remoteVersion.c_str(), "%d.%d.%d",
             &r1, &r2, &r3) != 3) {
    return false;
  }

  if (sscanf(currentVersion, "%d.%d.%d",
             &c1, &c2, &c3) != 3) {
    return false;
  }

  if (r1 < 0 || r2 < 0 || r3 < 0 ||
      c1 < 0 || c2 < 0 || c3 < 0) {
    return false;
  }

  if (r1 != c1) return r1 > c1;
  if (r2 != c2) return r2 > c2;

  return r3 > c3;
}

// ==================================================
// HTTPS GET
// ==================================================
bool httpsGet(const char* url, String& response) {
  WiFiClientSecure client;

  // 測試用途；正式使用請驗證 CA 憑證
  client.setInsecure();

  HTTPClient http;
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setTimeout(HTTP_TIMEOUT);

  if (!http.begin(client, url)) {
    Serial.println("HTTPS 初始化失敗");
    return false;
  }

  int code = http.GET();

  if (code == HTTP_CODE_OK) {
    response = http.getString();
    http.end();
    return true;
  }

  Serial.printf("HTTP GET 失敗：%d\n", code);
  http.end();
  return false;
}

// ==================================================
// 讀取 GitHub version.json
// ==================================================
String getLatestVersion() {
  String json;

  latestFirmwareURL = "";
  latestCommit = "";

  if (!httpsGet(VERSION_URL, json)) {
    Serial.println("無法讀取 GitHub 版本檔");
    return "";
  }

  Serial.println("===== GitHub version.json =====");
  Serial.println(json);

  JsonDocument doc;
  DeserializationError error = deserializeJson(doc, json);

  if (error) {
    Serial.print("JSON 解析失敗：");
    Serial.println(error.c_str());
    return "";
  }

  const char* version = doc["version"] | "";
  const char* firmwareURL = doc["firmware_url"] | "";
  const char* commit = doc["commit"] | "";

  if (strlen(version) == 0 ||
      strlen(firmwareURL) == 0) {
    Serial.println("JSON 缺少必要欄位");
    return "";
  }

  latestFirmwareURL = firmwareURL;
  latestCommit = commit;

  if (!latestFirmwareURL.startsWith("https://")) {
    Serial.println("韌體網址必須使用 HTTPS");
    latestFirmwareURL = "";
    return "";
  }

  int v1, v2, v3;

  if (sscanf(version, "%d.%d.%d", &v1, &v2, &v3) != 3 ||
      v1 < 0 || v2 < 0 || v3 < 0) {
    Serial.println("版本號格式錯誤");
    latestFirmwareURL = "";
    return "";
  }

  return String(version);
}

// ==================================================
// 下載並安裝 GitHub 韌體
// ==================================================
bool downloadAndInstallFirmware() {
  if (updateInProgress || latestFirmwareURL.isEmpty()) {
    return false;
  }

  updateInProgress = true;

  WiFiClientSecure client;
  client.setInsecure();

  HTTPClient http;
  http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
  http.setTimeout(30000);

  Serial.println("開始下載 GitHub 韌體");
  Serial.println(latestFirmwareURL);

  if (!http.begin(client, latestFirmwareURL)) {
    Serial.println("韌體連線初始化失敗");
    updateInProgress = false;
    return false;
  }

  int code = http.GET();

  if (code != HTTP_CODE_OK) {
    Serial.printf("韌體下載失敗，HTTP=%d\n", code);
    http.end();
    updateInProgress = false;
    return false;
  }

  int contentLength = http.getSize();

  if (contentLength <= 0) {
    Serial.println("韌體檔案大小無效");
    http.end();
    updateInProgress = false;
    return false;
  }

  Serial.printf("韌體大小：%d bytes\n", contentLength);

  if (!Update.begin((size_t)contentLength)) {
    Serial.println("OTA 無法開始，請檢查分割區空間");
    Update.printError(Serial);
    http.end();
    updateInProgress = false;
    return false;
  }

  WiFiClient* stream = http.getStreamPtr();
  size_t written = Update.writeStream(*stream);

  Serial.printf("已寫入：%u / %d bytes\n",
                (unsigned int)written, contentLength);

  http.end();

  bool success = false;

  if (written == (size_t)contentLength) {
    success = Update.end(true);
  } else {
    Serial.println("韌體下載不完整，中止更新");
    Update.abort();
  }

  if (!success) {
    Serial.println("OTA 更新失敗");
    Update.printError(Serial);
    updateInProgress = false;
    return false;
  }

  Serial.println("OTA 更新成功，即將重新啟動");
  delay(1000);
  ESP.restart();

  return true;
}

// ==================================================
// 檢查 GitHub 更新
// ==================================================
void checkGitHubUpdate() {
  if (updateInProgress) return;

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi 未連線，略過版本檢查");
    return;
  }

  Serial.println();
  Serial.println("===== GitHub OTA 版本檢查 =====");
  Serial.printf("目前版本：%s\n", CURRENT_VERSION);

  String remoteVersion = getLatestVersion();

  if (remoteVersion.length() == 0) {
    Serial.println("無法取得有效版本，稍後再試");
    return;
  }

  Serial.printf("GitHub 版本：%s\n", remoteVersion.c_str());
  Serial.printf("更新資訊：%s\n", latestCommit.c_str());

  if (isNewerVersion(remoteVersion, CURRENT_VERSION)) {
    Serial.println("發現新版，開始 OTA 更新");
    downloadAndInstallFirmware();
  } else {
    Serial.println("目前沒有較新的版本");
  }
}

// ==================================================
// 手動 OTA 上傳
// ==================================================
bool manualUploadFailed = false;
bool manualUploadStarted = false;

void handleUpload() {
  HTTPUpload& upload = server.upload();

  if (upload.status == UPLOAD_FILE_START) {
    manualUploadFailed = false;
    manualUploadStarted = false;

    Serial.printf("手動 OTA 開始：%s\n",
                  upload.filename.c_str());

    if (!upload.filename.endsWith(".bin")) {
      Serial.println("只允許上傳 .bin 檔案");
      manualUploadFailed = true;
      return;
    }

    if (!Update.begin(UPDATE_SIZE_UNKNOWN)) {
      Update.printError(Serial);
      manualUploadFailed = true;
      return;
    }

    manualUploadStarted = true;

  } else if (upload.status == UPLOAD_FILE_WRITE) {
    if (manualUploadStarted && !manualUploadFailed) {
      if (Update.write(upload.buf, upload.currentSize) !=
          upload.currentSize) {
        Update.printError(Serial);
        manualUploadFailed = true;
      }
    }

  } else if (upload.status == UPLOAD_FILE_END) {
    if (manualUploadStarted && !manualUploadFailed) {
      if (Update.end(true)) {
        Serial.printf("手動 OTA 成功：%u bytes\n",
                      upload.totalSize);
      } else {
        Update.printError(Serial);
        manualUploadFailed = true;
      }
    }

  } else if (upload.status == UPLOAD_FILE_ABORTED) {
    if (manualUploadStarted) {
      Update.abort();
    }

    manualUploadFailed = true;
    Serial.println("手動 OTA 已中止");
  }
}

// ==================================================
// Setup
// ==================================================
void setup() {
  Serial.begin(115200);
  delay(500);

  Serial.println();
  Serial.println("ESP32 GitHub OTA 啟動");
  Serial.printf("目前韌體版本：%s\n", CURRENT_VERSION);

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.print("正在連接 Wi-Fi");

  unsigned long startTime = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - startTime < 30000) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("Wi-Fi 連線成功");
    Serial.print("IP 位址：");
    Serial.println(WiFi.localIP());

    if (MDNS.begin(host)) {
      Serial.println("mDNS 已啟動：http://esp32.local");
    } else {
      Serial.println("mDNS 啟動失敗");
    }
  } else {
    Serial.println("Wi-Fi 連線逾時，稍後重試");
  }

  server.on("/", HTTP_GET, []() {
    server.sendHeader("Connection", "close");
    server.send(200, "text/html; charset=utf-8", loginIndex);
  });

  server.on("/serverIndex", HTTP_GET, []() {
    String page = String(serverIndex);

    page.replace("CURRENT_VERSION_PLACEHOLDER",
                 CURRENT_VERSION);

    server.sendHeader("Connection", "close");
    server.send(200, "text/html; charset=utf-8", page);
  });

  server.on("/update", HTTP_POST,
    []() {
      bool success = manualUploadStarted &&
                     !manualUploadFailed &&
                     !Update.hasError();

      server.sendHeader("Connection", "close");
      server.send(success ? 200 : 500, "text/plain",
                  success ? "OK" : "FAIL");

      if (success) {
        delay(500);
        ESP.restart();
      }
    },
    handleUpload
  );

  server.onNotFound([]() {
    server.send(404, "text/plain", "Not found");
  });

  server.begin();
  Serial.println("Web OTA Server Started");

  // 開機後立即檢查
  lastUpdateCheck = millis() - UPDATE_INTERVAL;
}

// ==================================================
// Loop
// ==================================================
void loop() {
  server.handleClient();

  static unsigned long lastWiFiRetry = 0;

  if (WiFi.status() != WL_CONNECTED &&
      millis() - lastWiFiRetry >= 10000) {
    lastWiFiRetry = millis();
    WiFi.reconnect();
  }

  if (!updateInProgress &&
      millis() - lastUpdateCheck >= UPDATE_INTERVAL) {
    lastUpdateCheck = millis();
    checkGitHubUpdate();
  }

  delay(1);
}
