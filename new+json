<div id="progressBar"></div>
</div>
<p id="updateStatus">等待上傳</p>
<small>請選擇適用於目前 ESP32 的韌體 .bin 檔案。</small>
</div>

<script>
const CURRENT_WEB_VERSION = "1.0.0";

const VERSION_URL =
"https://abbie210238.github.io/20261019_EPS32_OTAWebupdater/version.json";

const GITHUB_URL =
"https://github.com/abbie210238/20261019_EPS32_OTAWebupdater";

document.getElementById('currentVersion').textContent =
CURRENT_WEB_VERSION;

// 比較一般的數字版本，例如 1.0.0、1.1.0、2.0.0
function compareVersions(a,b){
  const pa = String(a).split('.').map(x => parseInt(x,10) || 0);
  const pb = String(b).split('.').map(x => parseInt(x,10) || 0);
  const n = Math.max(pa.length,pb.length);

  for(let i=0;i<n;i++){
    const x = pa[i] || 0;
    const y = pb[i] || 0;
    if(x > y) return 1;
    if(x < y) return -1;
  }
  return 0;
}

// 每次開啟管理頁面都檢查 GitHub
async function checkGitHubUpdate(){
  const box = document.getElementById('githubStatus');
  box.textContent = '正在連線 GitHub...';

  try{
    const response = await fetch(
      VERSION_URL + '?t=' + Date.now(),
      {cache:'no-store'}
    );

    if(!response.ok){
      throw new Error('HTTP ' + response.status);
    }

    const data = await response.json();

    if(!data.version){
      throw new Error('version.json 缺少 version 欄位');
    }

    const latestVersion = String(data.version);
    const commit = data.commit ? String(data.commit) : '';

    box.replaceChildren();

    const heading = document.createElement('strong');
    heading.textContent = 'GitHub 最新版本：' + latestVersion;
    box.appendChild(heading);

    const detail = document.createElement('p');

    const result = compareVersions(
      latestVersion,
      CURRENT_WEB_VERSION
    );

    if(result > 0){
      box.style.background = '#fef3c7';
      detail.textContent =
        '🆕 GitHub 有新版！請查看更新內容並重新載入網頁。';

      const link = document.createElement('a');
      link.href = GITHUB_URL;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = '前往 GitHub 專案查看更新';
      box.appendChild(detail);
      box.appendChild(link);

    }else if(result === 0){
      box.style.background = '#dcfce7';
      detail.textContent =
        '✅ 目前管理頁面版本與 GitHub 版本一致。';
      box.appendChild(detail);

    }else{
      box.style.background = '#dbeafe';
      detail.textContent =
        'ℹ️ GitHub 公布的版本號低於目前管理頁面版本。';
      box.appendChild(detail);
    }

    if(commit){
      const commitText = document.createElement('p');
      commitText.textContent = 'Commit: ' + commit;
      box.appendChild(commitText);
    }

  }catch(error){
    box.style.background = '#fee2e2';
    box.textContent =
      'GitHub 更新檢查失敗；請確認網路及 version.json。';
    console.error('GitHub version check failed:',error);
  }
}

checkGitHubUpdate();

// ===== OTA 韌體上傳 =====
document.getElementById('uploadForm').addEventListener(
  'submit',function(e){
    e.preventDefault();

    const fileInput = this.querySelector('input[type=file]');
    if(!fileInput.files.length){
      alert('請先選擇 .bin 韌體檔案');
      return;
    }

    const button = document.getElementById('uploadButton');
    const status = document.getElementById('updateStatus');
    const bar = document.getElementById('progressBar');

    const formData = new FormData();
    formData.append('update',fileInput.files[0]);

    const xhr = new XMLHttpRequest();
    button.disabled = true;
    status.textContent = '準備上傳...';

    xhr.open('POST','/update',true);
    xhr.timeout = 180000;

    xhr.upload.addEventListener('progress',function(evt){
      if(evt.lengthComputable){
        const percent = Math.round(evt.loaded / evt.total * 100);
        bar.style.width = percent + '%';
        status.textContent = '上傳進度：' + percent + '%';
      }
    });

    xhr.onload = function(){
      button.disabled = false;

      if(xhr.status === 200 && xhr.responseText.trim() === 'OK'){
        status.textContent = '更新成功，ESP32 即將重新啟動...';
      }else{
        status.textContent =
          '更新失敗：' + (xhr.responseText || xhr.status);
      }
    };

    xhr.onerror = function(){
      button.disabled = false;
      status.textContent =
        '連線中斷，請確認 ESP32 狀態。';
    };

    xhr.ontimeout = function(){
      button.disabled = false;
      status.textContent = '上傳逾時，請重新確認裝置狀態。';
    };

    xhr.send(formData);
  }
);
</script>
